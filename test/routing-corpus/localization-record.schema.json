{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "localizationRecord",
  "title": "localizationRecord",
  "description": "The shaped impulse that localizes a need: the file it is about and the evidence that the file is the site (what was read, and why it shows the site). Persisted on the gap record (gap.localization) and on the trace. A file-edit route and a compose admission require a valid record for a need that named no file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["file", "evidence", "method", "created_at"],
  "anyOf": [{ "required": ["gap_id"] }, { "required": ["dispatch_id"] }],
  "properties": {
    "gap_id": { "type": "string", "minLength": 1 },
    "dispatch_id": { "type": "string", "minLength": 1 },
    "file": { "type": "string", "pattern": "^repos/[\\w.-]+/[\\w./-]+\\.\\w+$" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["read", "why"],
        "properties": { "read": { "type": "string", "minLength": 1 }, "why": { "type": "string", "minLength": 1 } }
      }
    },
    "method": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
